{
  "name": "etymo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "contrat": "openapi-typescript ../contrat/openapi.json -o src/contrat/api.d.ts",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.89.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "license": "AGPL-3.0-or-later",
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
